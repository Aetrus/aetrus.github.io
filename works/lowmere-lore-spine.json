    "4": {
      "uid": 4,
      "key": [
        "market",
        "low tide",
        "the flats",
        "stall"
      ],
      "keysecondary": [],
      "comment": "The Low Tide Market",
      "content": "On the lowest tide of each month the flats below Lowmere open up and the Low Tide Market rises out of the sand, stall by stall, lantern by lantern. It sells small impossible goods. Prices are memories, favours, secrets and names, weighed on brass scales. The one hard rule: be up the sea stairs before the tide returns. Whoever is still on the flats when the water comes back stays with the Market.",
