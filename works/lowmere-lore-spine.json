    "6": {
      "uid": 6,
      "key": [
        "Mother Gannet",
        "Gannet",
        "weather in jars"
      ],
      "keysecondary": [],
      "comment": "Mother Gannet",
      "content": "Mother Gannet sells weather in jars: a summer afternoon, a sea mist, one jar of a thunderstorm she keeps behind the counter and will not sell. She does not haggle. She is older than the Market, by her account, and kinder than she sounds, by everyone else's.",
