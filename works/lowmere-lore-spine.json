    "3": {
      "uid": 3,
      "key": [
        "Farlight",
        "lighthouse",
        "lamp room"
      ],
      "keysecondary": [],
      "comment": "The Farlight",
      "content": "The Farlight is the lighthouse on the spit a mile past Lowmere, reached by a causeway the tide covers twice a day. A hundred and twelve steps to the lamp room. It faces the White, the unsurveyed sea, and its log has been kept in pencil by the Marr women for three generations. Ships do not come in from the White. Other things do, and the keeper logs them under the weather. Isolde Marr is the keeper.",
