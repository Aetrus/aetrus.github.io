    "5": {
      "uid": 5,
      "key": [
        "the White",
        "unsurveyed",
        "fog",
        "company"
      ],
      "keysecondary": [],
      "comment": "The White",
      "content": "The White is the sea past the last charted water. Compasses spin there; clocks keep their own time. Fog rolls in from it in the evenings and Isolde calls it company. Things that come out of the White are often from other years, other coasts, or nowhere anyone can name. Most are harmless. The log records forty years of arrivals and three departures.",
