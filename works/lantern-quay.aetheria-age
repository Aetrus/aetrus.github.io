ket and the salvage shed on the strand. Halfway up the cliff path is the Tidewater Inn. At the top is the Works, the glassworks that grinds lenses for every lighthouse on the coast.\n\nOff the strand lies Gull Rock, a tidal island with the Works' test tower and an old keeper's cottage, reached by a stone causeway that floods at high water.\n\nInland the ground rises to a heather moor with a ring of standing stones called the Teeth, where jackdaws nest, and a flooded sand quarry. The road to Harrowgate crosses the moor.\n\nIt is cold and grey most of the year, fog in the mornings, the sea never far off.","compiledBook":{"seed":"Lantern Quay","name":"Lantern Quay","structure":{"form":"scattered"},"terrain":{"profile":"rolling_hills","intensity":0.5},"ground":{"palette":"temperate_verdant","vegetation":0.4},"sky":{"palette":"pale_white"},"climate":{"latitude":"temperate"},"water":{"level":0.3},"fog":{"density":0.55},"suns":["gold"],"regions":[],"features":[],"unmapped":[]},"unmapped":[],"proseRevisions":[]},"provenance":{"layers.topography.structure.form":{"source":"default","updatedAt":1792436502000},"layers.topography.terrain.profile":{"source":"default","updatedAt":1792436502000},"layers.topography.terrain.intensity":{"source":"default","updatedAt":1792436502000},"layers.hydrology.water.level":{"source":"default","updatedAt":1792436502000},"layers.climate.climate.latitude":{"source":"default","updatedAt":1792436502000},"layers.ecology.ground.palette":{"source":"default","updatedAt":1792436502000},"layers.ecology.ground.vegetation":{"source":"default","updatedAt":1792436502000},"layers.atmosphere.sky.palette":{"source":"default","updatedAt":1792436502000},"layers.atmosphere.fog.density":{"source":"default","updatedAt":1792436502000},"layers.atmosphere.suns":{"source":"default","updatedAt":1792436502000},"layers.authoredFeatures.regions":{"source":"default","updatedAt":1792436502000},"identity.name":{"source":"prose","updatedAt":1792436502000,"confidence":0.95,"note":"Lantern Quay is a small harbour town"},"layers.atlas.enabled":{"source":"prose","updatedAt":1792436502000,"confidence":0.95,"note":"Lantern Quay is a small harbour town on a cold, foggy coast"},"layers.atlas.scale":{"source":"prose","updatedAt":1792436502000,"confidence":0.95,"note":"The road to Harrowgate crosses the moor"},"layers.atlas.sea":{"source":"prose","updatedAt":1792436502000,"confidence":0.95,"note":"a cold, foggy coast, built up a cliff above its harbour"},"layers.atlas.ground":{"source":"prose","updatedAt":1792436502000,"confidence":0.95,"note":"the sea never far off"},"layers.atmosphere.sky":{"source":"prose","updatedAt":1792436502000,"confidence":0.95,"note":"cold and grey most of the year"},"layers.atmosphere.fog":{"source":"prose","updatedAt":1792436502000,"confidence":0.95,"note":"fog in the mornings"},"layers.climate.climate":{"source":"prose","updatedAt":1792436502000,"confidence":0.95,"note":"a cold, foggy coast"},"layers.climate.temperature":{"source":"prose","updatedAt":1792436502000,"confidence":0.95,"note":"cold and grey most of the year"},"layers.hydrology.systems.tides":{"source":"prose","updatedAt":1792436502000,"confidence":0.95,"note":"a causeway that floods at high water"},"layers.atlas.places":{"source":"prose","updatedAt":1792436502000,"confidence":0.95,"note":"a flooded sand quarry"},"layers.atlas.relief":{"source":"prose","updatedAt":1792436502000,"confidence":0.95,"note":"built up a cliff above its harbour"},"layers.atlas.areas":{"source":"prose","updatedAt":1792436502000,"confidence":0.95,"note":"Inland the ground rises to a heather moor"},"layers.atlas.ways":{"source":"prose","updatedAt":1792436502000,"confidence":0.95,"note":"The road to Harrowgate crosses the moor"}},"locks":[]},"manifest":{"world_id":"age_lantern_quay_starter","book":{"seed":"Lantern Quay","name":"Lantern Quay","structure":{"form":"scattered"},"terrain":{"profile":"rolling_hills","intensity":0.5},"ground":{"palette":"temperate_verdant","vegetation":0.4},"sky":{"palette":"pale_white"},"climate":{"latitude":"temperate"},"water":{"level":0.3},"fog":{"density":0.55},"suns":["gold"],"regions":[],"features":[{"id":"lantern_quay","type":"town","name":"Lantern Quay","description":"A small harbour town built up a cliff above its harbour; it grinds the lenses for every lighthouse on the coast.","position":{"x":-3801,"z":-454.8},"aliases":[],"tags":["atlas","kind:port"],"provenance":{"source":"prose","updatedAt":1792436502000}},{"id":"the_harbour","type":"point-of-interest","name":"The harbour","description":"The harbour, inside its wall; three test lamps on the wall sweep the water at night.","position":{"x":-3881.4,"z":-576},"aliases":[],"tags":["atlas","kind:harbour"],"provenance":{"source":"prose","updatedAt":1792436502000}},{"id":"test_lamps","type":"landmark","name":"The test lamps","description":"Three lamps on the harbour wall; at night they sweep the water so the grinders can check their work.","position":{"x":-3881.9,"z":-550.2},"aliases":[],"tags":["atlas","kind:beacon"],"provenance":{"source":"prose","updatedAt":1792436502000}},{"id":"slipway","type":"point-of-interest","name":"The slipway","description":"Slipway in Lantern Quay.","position":{"x":-3877.5,"z":-629.8},"aliases":[],"tags":["atlas","kind:slipway"],"provenance":{"source":"prose","updatedAt":1792436502000}},{"id":"fish_market","type":"point-of-interest","name":"The fish market","description":"Fish market in Lantern Quay.","position":{"x":-3851.3,"z":-602.4},"aliases":[],"tags":["atlas","kind:fish_market"],"provenance":{"source":"prose","updatedAt":1792436502000}},{"id":"salvage_shed","type":"point-of-interest","name":"The salvage shed","description":"Dilys Pengelly's shed on the strand. TIDERIGHT. ALL FINDS PRICED.","position":{"x":-3875.4,"z":-632.1},"aliases":[],"tags":["atlas","kind:warehouse"],"provenance":{"source":"prose","updatedAt":1792436502000}},{"id":"the_works","type":"point-of-interest","name":"The Works","description":"The glassworks at the top of the cliff, which grinds lenses for every lighthouse on the coast; Ansel Truscott is its master grinder, and its grinding floor never goes dark.","position":{"x":-3706.5,"z":-595.2},"aliases":[],"tags":["atlas","kind:works"],"provenance":{"source":"prose","updatedAt":1792436502000}},{"id":"tidewater_inn","type":"point-of-interest","name":"Tidewater Inn","description":"Halfway up the cliff path. Bad tea, cards by the fire.","position":{"x":-3798.2,"z":-629.9},"aliases":[],"tags":["atlas","kind:inn"],"provenance":{"source":"prose","updatedAt":1792436502000}},{"id":"gull_rock","type":"landmark","name":"Gull Rock","description":"A tidal island off the strand: the Works' test tower and an old keeper's cottage.","position":{"x":-4290.6,"z":-735.4},"aliases":[],"tags":["atlas","kind:island"],"provenance":{"source":"prose","updatedAt":1792436502000}},{"id":"test_tower","type":"point-of-interest","name":"The test tower","description":"The Works' test tower, where big lenses are lit and checked against the sea.","position":{"x":-4314.8,"z":-749.7},"aliases":[],"tags":["atlas","kind:tower"],"provenance":{"source":"prose","updatedAt":1792436502000}},{"id":"keepers_cottage","type":"point-of-interest","name":"The keeper's cottage","description":"House in Gull Rock.","position":{"x":-4250.7,"z":-761.2},"aliases":[],"tags":["atlas","kind:house"],"provenance":{"source":"prose","updatedAt":1792436502000}},{"id":"the_constance","type":"landmark","name":"The Constance","description":"The lighter barge that capsized off the causeway with the Cape Morrow lens; on her side in four fathoms.","position":{"x":-3948.2,"z":-730.2},"aliases":[],"tags":["atlas","kind:wreck"],"provenance":{"source":"prose","updatedAt":1792436502000}},{"id":"the_teeth","type":"landmark","name":"The Teeth","description":"A ring of standing stones on the moor, where the jackdaws nest.","position":{"x":-177.8,"z":2331.5},"aliases":[],"tags":["atlas","kind:stones"],"provenance":{"source":"prose","updatedAt":1792436502000}},{"id":"sand_quarry","type":"landmark","name":"The flooded quarry","description":"Where the Works' white sand came from, until it flooded.","position":{"x":356.5,"z":792.2},"aliases":[],"tags":["atlas","kind:quarry","flooded"],"provenance":{"source":"prose","updatedAt":1792436502000}},{"id":"cliff_path","type":"path","name":"The cliff path","description":"Path.","geometry":{"kind":"line","points":[{"x":-3881.4,"z":-576},{"x":-3835,"z":-527.6},{"x":-3823.5,"z":-647.8},{"x":-3769,"z":-560.3},{"x":-3750.3,"z":-645.4},{"x":-3707,"z":-612.2}]},"tags":["atlas","kind:path"],"provenance":{"source":"prose","updatedAt":1792436502000}},{"id":"the_causeway","type":"road","name":"The causeway","description":"Stone, from the strand to Gull Rock; floods two hours either side of high water.","geometry":{"kind":"line","points":[{"x":-3867.7,"z":-642.5},{"x":-3920.1,"z":-656.1},{"x":-3973.4,"z":-665.9},{"x":-4027.1,"z":-673.2},{"x":-4080.3,"z":-683.7},{"x":-4132.8,"z":-696.9},{"x":-4185.6,"z":-708.8},{"x":-4237.8,"z":-723.2},{"x":-4290.6,"z":-735.4}]},"tags":["atlas","kind:causeway"],"provenance":{"source":"prose","updatedAt":1792436502000}},{"id":"harrowgate_road","type":"road","name":"The Harrowgate road","description":"Inland across the moor to Harrowgate and its steam works.","geometry":{"kind":"line","points":[{"x":-3707,"z":-612.2},{"x":-3275.7,"z":-624},{"x":-2844.4,"z":-615.9},{"x":-2415.4,"z":-661.1},{"x":-1985.2,"z":-693.7},{"x":-1559.7,"z":-768.6},{"x":-1134,"z":-842.7},{"x":-701.9,"z":-848.2},{"x":-270.2,"z":-867.2},{"x":156.6,"z":-791.8},{"x":589.9,"z":-783.8},{"x":1015.4,"z":-708.9},{"x":1439.8,"z":-627.5},{"x":1871.4,"z":-645.9},{"x":2303.3,"z":-632.7},{"x":2735.3,"z":-639.9},{"x":3166.5,"z":-612.2},{"x":3600.7,"z":-581.1},{"x":4023.5,"z":-477.4},{"x":4435.5,"z":-332.5},{"x":4869.8,"z":-286.7},{"x":5303.4,"z":-281.9},{"x":5737,"z":-291},{"x":6172.4,"z":-265.9},{"x":6603.3,"z":-333.7},{"x":7035.2,"z":-320.2},{"x":7467.1,"z":-331.6},{"x":7897,"z":-391.4},{"x":8